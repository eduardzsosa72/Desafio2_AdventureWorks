                  <xs:element name="SalesTerritoryKey" type="xs:integer" minOccurs="0" />
                  <xs:element name="SalesOrderNumber" type="xs:string" minOccurs="0" />
                  <xs:element name="SalesOrderLineNumber" type="xs:unsignedByte" minOccurs="0" />
                  <xs:element name="RevisionNumber" type="xs:unsignedByte" minOccurs="0" />
                  <xs:element name="OrderQuantity" type="xs:short" minOccurs="0" />
                  <xs:element name="UnitPrice" type="xs:decimal" minOccurs="0" />
                  <xs:element name="ExtendedAmount" type="xs:decimal" minOccurs="0" />
                  <xs:element name="UnitPriceDiscountPct" type="xs:float" minOccurs="0" />
