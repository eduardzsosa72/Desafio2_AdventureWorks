                  <xs:element name="ProductStandardCost" type="xs:decimal" minOccurs="0" />
                  <xs:element name="TotalProductCost" type="xs:decimal" minOccurs="0" />
                  <xs:element name="SalesAmount" type="xs:decimal" minOccurs="0" />
                  <xs:element name="TaxAmt" type="xs:decimal" minOccurs="0" />
                  <xs:element name="Freight" type="xs:decimal" minOccurs="0" />
                </xs:sequence>
              </xs:complexType>
            </xs:element>

            <!-- FactResellerSales -->
            <xs:element name="FactResellerSales" msprop:DbTableName="FactResellerSales" msprop:TableType="Table">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="ProductKey" type="xs:integer" minOccurs="0" />
                  <xs:element name="OrderDateKey" type="xs:integer" minOccurs="0" />
                  <xs:element name="DueDateKey" type="xs:integer" minOccurs="0" />
                  <xs:element name="ShipDateKey" type="xs:integer" minOccurs="0" />
                  <xs:element name="ResellerKey" type="xs:integer" minOccurs="0" />
                  <xs:element name="EmployeeKey" type="xs:integer" minOccurs="0" />
                  <xs:element name="SalesTerritoryKey" type="xs:integer" minOccurs="0" />
                  <xs:element name="SalesOrderNumber" type="xs:string" minOccurs="0" />
                  <xs:element name="SalesOrderLineNumber" type="xs:unsignedByte" minOccurs="0" />
                  <xs:element name="RevisionNumber" type="xs:unsignedByte" minOccurs="0" />
                  <xs:element name="OrderQuantity" type="xs:short" minOccurs="0" />
                  <xs:element name="UnitPrice" type="xs:decimal" minOccurs="0" />
                  <xs:element name="ExtendedAmount" type="xs:decimal" minOccurs="0" />
                  <xs:element name="UnitPriceDiscountPct" type="xs:float" minOccurs="0" />
                  <xs:element name="DiscountAmount" type="xs:float" minOccurs="0" />
                  <xs:element name="ProductStandardCost" type="xs:decimal" minOccurs="0" />
                  <xs:element name="TotalProductCost" type="xs:decimal" minOccurs="0" />
                  <xs:element name="SalesAmount" type="xs:decimal" minOccurs="0" />
                  <xs:element name="TaxAmt" type="xs:decimal" minOccurs="0" />
                  <xs:element name="Freight" type="xs:decimal" minOccurs="0" />
                </xs:sequence>
              </xs:complexType>
            </xs:element>

            <!-- DimDate -->
