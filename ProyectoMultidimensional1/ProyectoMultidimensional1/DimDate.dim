        <DataType>SmallInt</DataType>
        <Source xsi:type="ColumnBinding">
          <TableID>DimDate</TableID>
          <ColumnID>CalendarYear</ColumnID>
        </Source>
      </NameColumn>
    </Attribute>
    <Attribute>
      <ID>Trimestre</ID>
