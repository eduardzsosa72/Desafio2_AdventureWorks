  <Source dwd:design-time-name="47ae9bcd-c83e-4ae6-a50d-e31708350f67">
    <DataSourceViewID>AdventureWorksDW2022</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="5d991d11-555d-4a9f-9ca9-ed3ebeb86d71">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T06:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T06:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CALCULATE;

CREATE MEMBER CURRENTCUBE.[Measures].[Ganancia Internet]
AS [Measures].[Ventas Internet] - [Measures].[Costo Producto Internet],
FORMAT_STRING = "Currency", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Ganancia Reseller]
AS [Measures].[Ventas Reseller] - [Measures].[Costo Producto Reseller],
FORMAT_STRING = "Currency", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Ganancia Total]
AS [Measures].[Ganancia Internet] + [Measures].[Ganancia Reseller],
FORMAT_STRING = "Currency", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Margen Internet Pct]
AS IIF([Measures].[Ventas Internet] = 0, NULL,
   ([Measures].[Ganancia Internet] / [Measures].[Ventas Internet]) * 100),
FORMAT_STRING = "#0.00", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Margen Reseller Pct]
AS IIF([Measures].[Ventas Reseller] = 0, NULL,
   ([Measures].[Ganancia Reseller] / [Measures].[Ventas Reseller]) * 100),
FORMAT_STRING = "#0.00", VISIBLE = 1;
</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>